# Vamp OS for the Shanling Q2 (docs/vamp-os-base.md). Userspace ABI as stock's: MIPS32R2 little-endian, o32,
# hard float with a 64-bit FPU (FR=1), IEEE 754-2008 NaN and abs (docs/third-party.md#toolchain), so the
# dynamic linker is /lib/ld-linux-mipsn8.so.1. The NaN 2008 choice on R2 needs
# os/patches/buildroot/0001-arch-mips-offer-nan-2008-on-generic-mips32r2.patch.
BR2_mipsel=y
BR2_mips_32r2=y
# BR2_MIPS_SOFT_FLOAT is not set
BR2_MIPS_FP32_MODE_64=y
BR2_MIPS_ENABLE_NAN_2008=y
BR2_TARGET_OPTIMIZATION="-mabs=2008"

# Buildroot's own toolchain: glibc, headers of the Q2's kernel line (5.10.21), so the libc assumes no system
# call the kernel lacks, and 64-bit time_t for everything in the image.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_5_10=y
BR2_TIME_BITS_64=y

BR2_REPRODUCIBLE=y

# No init system package: BusyBox init with this tree's inittab and rcS, runit's applets for the services.
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_HOSTNAME="vamp"
BR2_TARGET_GENERIC_ISSUE="Vamp OS"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_VAMP_PATH)/board/q2/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_VAMP_PATH)/board/q2/post-build.sh"
# No /etc/network/interfaces: q2netd brings up Wi-Fi (docs/netd.md)
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_VAMP_PATH)/board/q2/busybox.fragment"

BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_Q2PLAYER=y
BR2_PACKAGE_Q2PLAYD=y
BR2_PACKAGE_Q2SYSD=y
BR2_PACKAGE_Q2LIBD=y
BR2_PACKAGE_Q2NETD=y
BR2_PACKAGE_Q2PKGD=y
BR2_PACKAGE_Q2DACLOOP=y
BR2_PACKAGE_Q2_IAP=y
# the image's mksquashfs composes LZO images (q2pkgd); gzip, its default, not needed
BR2_PACKAGE_SQUASHFS_LZO=y
# BR2_PACKAGE_SQUASHFS_GZIP is not set
BR2_PACKAGE_Q2UI=y
BR2_PACKAGE_VAMP_ASSETS=y
# adb over USB and Wi-Fi (docs/vamp-os-base.md#adb), and Wi-Fi itself (q2netd)
BR2_PACKAGE_Q2ADB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y

# What mtd2 holds: squashfs, LZO, 128 KiB blocks, as stock's rootfs.squashfs and tools/build.py's repack
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_LZO=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_128K=y
# BR2_TARGET_ROOTFS_TAR is not set
