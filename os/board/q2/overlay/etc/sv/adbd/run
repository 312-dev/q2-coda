#!/bin/sh
# adbd over USB (docs/adb.md#adbd, docs/vamp-os-base.md#adb): the q2adb gadget made, adbd started, and the gadget
# put on the controller once adbd has written its descriptors (q2adb-gadget bind waits for them). A computer gets in
# only with a key in /mnt/data/adb_keys or the card's adb_keys: nothing here answers adbd's prompt socket, so an
# unknown key is refused at once.
. /usr/libexec/vamp/log
. /usr/libexec/vamp/outer
if outer_usb_adbd; then
    # another adbd has the USB side (today's Vamp's, outside a card boot's chroot): looked at again in 30 s
    step "adbd: an outer adbd serves USB, left to it"
    exec sleep 30
fi
if ! /usr/bin/q2adb-gadget setup; then
    step "adbd: no USB gadget (configfs or FunctionFS refused)"
    exec sleep 30
fi
/usr/bin/q2adb-gadget bind &
step "adbd: start"
exec 2>&1
exec /usr/bin/adbd
