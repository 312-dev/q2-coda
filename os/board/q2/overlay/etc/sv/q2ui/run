#!/bin/sh
# q2ui, the screen and the keys (ui/ on feat/render-engine). Its library is /mnt/data/database.db; without one it
# ends at once. kill -HUP restarts it in place (the same process, its options read again, its pages kept); any end is
# started again by runsv (finish), while q2playd plays on.
. /usr/libexec/vamp/log
if [ ! -e /dev/fb0 ]; then
    step "q2ui: no /dev/fb0"
    exec sleep 2
fi
step "q2ui: start"
exec 2>&1
exec /usr/bin/q2ui --fonts /usr/share/vamp/fonts --icons /usr/share/vamp/icons
