#!/bin/sh
# q2ui, the screen and the keys (ui/ on feat/render-engine). Its library is q2libd's (docs/libd.md): the card's in
# /mnt/data/vamp/library.db, which q2libd writes, empty, before anything else, and the servers' in
# /mnt/mmc/.vamp/catalogue.db. kill -HUP restarts it in place (the same process, its options read again, its pages kept); any end is
# started again by runsv (finish), while q2playd plays on.
. /usr/libexec/vamp/log
if [ ! -e /dev/fb0 ]; then
    step "q2ui: no /dev/fb0"
    exec sleep 2
fi
# rcS's boot animation plays to its end first, as demo waits for it on today's Vamp (patch/splash_hold.c): q2splash
# keeps /tmp/q2splash.run while it plays and removes it at its end. It holds an fcntl lock there, which BusyBox's
# flock(1) cannot see (flock(2)), so the wait is for the file to go, at most 10 s (the animation is 7.4 s); a q2splash
# that died leaves the file, and it is removed then, which also stops one that is still drawing.
if [ -e /tmp/q2splash.run ]; then
    n=0
    while [ -e /tmp/q2splash.run ] && [ $n -lt 100 ]; do sleep 0.1; n=$((n + 1)); done
    rm -f /tmp/q2splash.run
    step "q2ui: the boot animation done after $n tenths"
fi
step "q2ui: start"
exec 2>&1
# the settings pipe q2gate reads (docs/gate.md), on fd 3: opened both ways, so neither end waits for the other
[ -p /run/vamp/ui.ctl ] || mkfifo -m 600 /run/vamp/ui.ctl
exec 3<>/run/vamp/ui.ctl
exec /usr/bin/q2ui --ctl 3 --db /mnt/data/vamp/library.db --catalogue /mnt/mmc/.vamp/catalogue.db \
    --fonts /usr/share/vamp/fonts --icons /usr/share/vamp/icons
