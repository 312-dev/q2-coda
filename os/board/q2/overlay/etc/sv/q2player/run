#!/bin/sh
# q2player (player/, docs/player.md). It is the client of /tmp/sock_play, whose server is q2playd (docs/playd.md):
# started at the same moment, it waits for it up to five seconds, and finish waits before a next try.
. /usr/libexec/vamp/log
step "q2player: start"
exec 2>&1
exec /usr/bin/q2player
