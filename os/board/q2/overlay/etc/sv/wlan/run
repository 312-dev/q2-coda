#!/bin/sh
# Wi-Fi, until q2netd (docs/vamp-os.md#m6-the-services): wpa_supplicant on wlan0 with the networks stock and today's
# Vamp saved, /mnt/data/wpa_supplicant.conf, as stock's wifi_connect.sh starts it (nl80211). Without the file or
# the interface it looks again later.
. /usr/libexec/vamp/log
conf=/mnt/data/wpa_supplicant.conf
if [ ! -f $conf ]; then
    step "wlan: no $conf"
    exec sleep 60
fi
if ! ifconfig wlan0 up 2> /dev/null; then
    step "wlan: no wlan0"
    exec sleep 30
fi
step "wlan: start"
exec 2>&1
exec /usr/sbin/wpa_supplicant -Dnl80211 -iwlan0 -c$conf
