<!-- Theme: OLED (docs/ipod.md#theme), built to docs/oled-design.md: the one built-in theme. A black screen, white
     Inter in sentence case, one accent (Arterial red unless Blue is chosen). It states its own grid (its <geometry>) and draws its own art
     (tools/art.py oled_*: Phosphor's glyphs). Sizes here are AWTK's, which scales a face so that its ascent less its
     descent is the size: Inter's line is 1.21 em, so the design's 20 px type is 24 here, its 15 px 18, its 22 px 27.
     Its numbers that track patch/offsets.inc (Home's Full label end, the scheme colours, Cover Flow's CF_* and the
     motion) come from there via tools/theme.py ROLE_MACROS. -->
<theme format="1" id="oled" name="OLED" index="0">
  <!-- The grid (oled-design.md Corners and Spacing): a status row centred on y 23 in a 58 px bar drawn black, so
       no band shows; the page's title from x 62, the play state and battery ending 62 px from the right edge, inside
       the glass's top curve (STATUS_ROW_INSET, patch/offsets.inc). Then
       32 px rows from y 58, the text at x 24, seven of them: list_end ends the list at y 282, the
       strip below stays black and the selection never lands there; a list scrolls a row at a time. Songs and Folder's
       rows are one 32 px line; Albums, Playlists and Search are two lines at 52 px, four to a page (a list box holds whole rows): 40 px
       art at x 24, the text at 72 (list.art below). Text y puts each line where the design's baselines are. Home in
       Split: the menu's rows 204 px wide, so the bar ends at 188 and the chevrons stand at 176 (the right column from
       the row's edge); the playing album's art (stopped or paused, the library's covers in turn, cross-fading: coverflow.c art_source)
       from x 196 and the top edge to the screen's right and bottom edges,
       under the status row's play state and battery (each of their pixels inked white or black, whichever stands
       out more against the art under it: coverflow.c home_ink), the glass rounding its corners, panning slowly across its 110 % zoom with 2 % of the zoom kept clear at each edge, so a
       cover's own border never shows (coverflow.c drift_axis). -->
  <geometry bar="58" pitch="32" body="32" art="40" art_inset="6" art_pitch="52"
            art_body="52" text_art="0" text_art_inset="0" lib_pitch="32" lib_body="32" lib_inset="0"
            lib_art="0" title24_y="4" title_y="6" meta_y="8"
            count_y="8" art_title24_y="6" art_meta_y="33" folder_pitch="32" folder_body="32" song_pitch="32" song_body="32" song_title24_y="4"
            song_meta_y="8" playlist_pitch="52" set_row="32" set_top="0" set_rows="7"
            set_icon="0" stream_row="32" bar_px="18" batt_w="25" batt_h="12"
            text_x="24" list_end="224" status_y="23" right_x="28"
            action_row="32" home_row="32" home_lib="0"
            stock_row="32" stock_body="32" stock_title_y="0" stock_title_h="32"
            search_row="52" search_body="52" search_art="0" search_title_y="4" search_title24_y="4" search_title_h="28"
            search_meta_y="31" search_meta_h="20" np_art="150" np_bar_y="228"
            split_row="204" split_art="196" split_art_up="58" split_inset="2"/>
  <!-- Colour (oled-design.md Colour): the accent, one value for the bar, the progress fill and every mapped red, as
       its own scheme's five tones: Arterial by default (the owner's #B8121B at the 6-bit panel's level), Blue, the
       accent before it, still offered; white text on it in both halves; second lines in Text Tertiary (stock's #aaaaaa
       secondary text turns muted); the light half on white paper with black ink. OLED_ACCENT indexes the ACCENTS rows,
       then these in order (Blue 10, Arterial 11); the 9 a Q2 stored while Blue was the one value now names the
       ACCENTS row Arterial, which this theme does not offer, so it reads as the default. -->
  <colorScheme name="oled-blue" base="cobalt" label="Blue" tones="#2160d8 #2160d8 #2160d8 #2160d8 #2160d8"/>
  <colorScheme name="oled-arterial" base="arterial" label="Arterial" tones="#b8141c #b8141c #b8141c #b8141c #b8141c"/>
  <colorSchemes accents="oled-blue oled-arterial"/>
  <colorScheme sel.text="#ffffff" light.sel.text="#ffffff" muted="#858585" light.paper="#ffffff" light.ink="#000000"/>
  <option setting="light" preset="off" keep="auto"/>
  <option setting="accent" key="OLED_ACCENT" default="oled-arterial" preset="oled-arterial"/>
  <option setting="home" preset="split"/>
  <option setting="battery" values="icon percent" default="icon"/>
  <!-- Song rows (oled-design.md Song rows, patch/song_rows.c): where a mixed list's artist stands, and which lists
       show each song's length -->
  <option key="SONGARTIST" label="Song Artist" default="Inline" preset="Inline"><value label="Inline"/><value label="Selected Row"/><value label="Right"/><value label="Off"/></option>
  <option key="SONGLENGTH" label="Song Length" default="Albums" preset="Albums"><value label="Albums"/><value label="All Lists"/><value label="Off"/></option>
  <!-- Now Playing's right-hand time: what is left of the track or its length; a tap on it switches (np_bar.c) -->
  <option key="NPTIME" label="Track Time" default="Remaining" preset="Remaining"><value label="Remaining"/><value label="Total"/></option>
  <!-- The status row's title and clock: Inter Medium 15 (18 here); the slim battery and its play state, the
       theme's own art -->
  <view name="bar">
    <element name="title" font="inter-medium" font_size="18"/>
  </view>
  <!-- The type roles (oled-design.md Type): rows and values Inter Regular 20 (24), second lines 15 (18), the Now
       Playing title Inter Medium 22 (27), small text 15 (18). The selection is the accent's flat bar, 16 px in
       from each side with 8 px ends on every row. Each row that opens a page has the theme's caret on the right
       column; a settings row's value is right-aligned there in Text Secondary (#5c5c5c on paper). The scroll
       indicator: a 4 px track 72 px tall centred on the list (y 134 to 206), 5 px from the edge, with its thumb,
       while the wheel turns. -->
  <view name="list">
    <element name="selection" inset="16" radius="8"/>
    <element name="icons" mono="1" badge_muted="1" addon_mono="1"/>
    <!-- A list left by Return forgets its row: choosing it again opens it at the top, as an iPod's menus and stock's
         pages do (navigation.c forget_left); Return still lands on the row the parent was left at. -->
    <element name="reopen" top="1"/>
    <element name="row" font="inter" title_px="24" meta_font="inter" meta_px="18" tall_font="inter" tall_px="24"/>
    <element name="art" x="24" text_x="72" text_end="319" placeholder="40" radius="4"/>
    <!-- A scrolling text's ends fade into what is behind it (oled-design.md Motion, list_marks.c marquee_fade): rows,
         the status row's title and Now Playing's lines -->
    <element name="marquee" fade="1"/>
    <!-- Songs', an album's and a playlist's action row reads Shuffle after Phosphor's shuffle, in the accent (white on the
         selection); the wheel steps onto it above the first song and Centre shuffles the list (navigation.c shuffle_key) -->
    <element name="shuffle" row="1"/>
    <!-- Text entry the iPod's way: Search opens an iPod classic's letter strip over the songs it matches, filtered
         as each letter goes in (search_strip.c, docs/ipod.md#search); the keyboard other text boxes open is dark and
         the wheel walks its keys (keyboard.c, docs/ipod.md#keyboard) -->
    <element name="entry" ipod="1"/>
    <element name="scrollbar" w="4" right="5" top="134" bottom="206" min="8"
             dark.thumb="#e5e5e5" light.thumb="#1a1a1a" dark.track="#3a3a3a" light.track="#c5c5c5"/>
  </view>
  <!-- Settings rows: a value in Text Secondary on the right column; an on/off setting a 34x20 switch there in place of
       "On" or "Off" (oled-design.md List row, list_marks.c switch_mark) -->
  <view name="settings"><element name="rows" top="0"/><element name="values" text="1" switch="1" dark.ink="#ababab" light.ink="#5c5c5c"/></view>
  <view name="home">
    <element name="rows" top="0" text_x="24" full_row="375" label_end_split="44" font="inter" font_px="24"/>
    <element name="chevron" visible="1"/>
    <!-- In Split the art is the main menu's alone: Settings, and Library and Streaming where they open in Home's
         window, are full-width pages (audit RULES 1) -->
    <element name="lists" full="1"/>
  </view>
  <!-- Now Playing on the grid (oled-design.md Now Playing; the set's np_art and np_bar_y, tools/ipod.py np_grid): 6 px
       art corners, the title Inter Medium 22 (27 here), the artist and album Inter at the page's 18 (22 here), a 6 px
       bar on the Track grey, shuffle and repeat as the theme's own glyphs (tools/art.py mode_*) -->
  <view name="playing">
    <element name="art" radius="6"/>
    <element name="title" font="inter-medium" font_px="27"/>
    <element name="artist" font="inter"/>
    <element name="album" opacity="255"/>
    <element name="info" font="inter" font_size="18" light.value="#010101" dark.value="#FFFFFF"/>
    <element name="scrubber" height="6" scrub_height="6" track="#333333"/>
    <element name="modes" icons="1"/>
    <element name="state" opacity="0"/>
  </view>
  <!-- page_list's rows (the Library's Shuffle, Most Played, card apps...): the grid's 32 px rows, 52 with a detail,
       at the text inset; the status row names the page, so no title row -->
  <!-- Cover Flow in the 262 px window under the status row (oled-design.md Screens: covers on black, no reflection
       floor): the reflection's top at 0 of its cover's brightness, so it is the page's own colour and none shows,
       and the caption right under the covers, the album in the Song title role (22, 27 here) and the artist in the
       Artist role (18, 22 here). The artist's box 27 px under the album's puts its baseline 24 px under the album's
       (about 1.1 times the 22 px title, as iOS spaces a title and its subtitle) and leaves 5 px between a g's tail
       and the artist's capitals; at 22 they touched -->
  <!-- Cover Flow's shelf: where the side covers stand is the iPod preset of #329's Cover Flow Parameter Lab, its
       units times 0.16 (docs/internals.md#coverflow-depth); the rest takes CF_* (ROLE_MACROS). At speed (arch_at to
       arch_full albums/s, Fast Navigation off) the covers within arch_span of the middle bend into the lab's arch,
       forming over arch_in ms and relaxing over arch_out, the covers following the wheel by arch_tau ms.
       The thumb: the wheel holds the covers (docs/internals.md#coverflow-thumb); these are its numbers, to retune on
       the wheel. A spin goes by letters, one each jump_ticks of travel (0: never). With Fast Navigation off, after
       jump_ms at jump_at ticks/s or more, they are named on the moving row, jump_pace apart, until the thumb slows or
       turns back; on, after big_jump_ms at big_jump_at, a faster spin as a false start costs more, they last until
       the thumb lifts: the row comes in over enter_albums, slides from letter to letter (slide_ms) and folds out once
       within fold_near of the letter. -->
  <view name="coverflow">
    <element name="shelf" eye="256" tilt="90" x1="128" xs="35" z1="77" zs="0" horizon="64" swing="2"
             arch_at="8" arch_full="16" arch_span="500" arch_in="100" arch_out="62" arch_tau="56"
             thumb="1" ticks_turn="36" ticks_album="7" fast_at="23" fast_full="90" top_speed="20" track="30"
             snap="25" spin="130" far_left="250" detent="80" hold_ms="5000" stop_ms="60" stop_left="60" rate_up="120"
             rate_down="50" back="50" dead="1" contact_ms="40" aim_snap="30" lead_from="25" lead_full="100" lead_ms="45"
             row_shift="20" row_from="100" row_full="300" row_shrink="8" row_flat="200" row_out="33" row_edge="160"
             row_width="40" row_key="72" jump_ms="700" jump_ticks="5" jump_at="32" jump_pace="140"
             big_jump_at="75" big_jump_ms="240" enter_albums="8" slide_ms="160" fold_near="50" reflect_top="0"/>
    <element name="caption" name_px="27" artist_px="22" text_y="173" artist_y="27"/></view>
  <view name="page">
    <element name="rows" height="32" detail_height="52" text_x="24" title_y="4" title_h="24" detail_y="31" detail_h="20"/>
    <element name="title" height="0"/>
  </view>
  <view name="pages"><element name="own" art_final="1"/></view>
</theme>
