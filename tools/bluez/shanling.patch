+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Receiver mode's signals to demo (Q2 Pod's docs/bluetoothd.md, "Receiver mode"): stock's wrappers
+ * round bluez_play_info_signal.
+ */
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <pthread.h>
+
+#include "src/shanling.h"
+
+void shanling_play_state(int duration, int position, int status)
+{
+	int v[3] = { duration, position, status };
+
+	bluez_play_info_signal(SHANLING_PLAY_STATE, v, sizeof(v));
+}
