+
+	/* The Quality page's codec first, then LDAC, aptX HD, aptX, AAC, SBC;
+	 * any other codec's endpoints are left out
+	 */
+	switch (g_high_priority_lcodec) {
+	case 0x13:
+		order[0] = 0x12d;
+		break;
+	case 0x12:
+		order[0] = 0xd7;
+		break;
+	case 0x11:
+		order[0] = 0x4f;
+		break;
+	case A2DP_CODEC_MPEG24:
+		order[0] = A2DP_CODEC_MPEG24;
+		break;
+	default:
+		order[0] = A2DP_CODEC_SBC;
