--- /dev/null
+++ b/src/shanling.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Shanling's libbtctl.so, which stock's bluetoothd links (Q2 Pod's docs/bluetoothd.md): its D-Bus
+ * service in bluetoothd, its signal to demo, and the state demo keeps in it. Declared here as the
+ * library defines them; no header ships with it.
+ */
+
+#include <pthread.h>
+
+/* The playing track as demo last sent it (NotifyChanged 0x108) */
+struct shanling_track_meta {
+	int track;		/* its number */
+	int total;		/* tracks in its list */
+	int time;		/* length, ms */
+	char *title;
+	char *artist;
+	char *album;
+	char *genre;
+};
+
+extern struct shanling_track_meta *g_track_meta;
+extern int g_play_status;
+extern pthread_mutex_t g_notify_mutex;
+extern void (*g_avrcp_event_fun)(int id, void *data);
+extern unsigned char g_high_priority_lcodec;
+extern unsigned char g_synclink_mode;
+
+void bluez_main(void);
+int bluez_play_info_signal(int event, void *data, int len);
+
+/* PlayInfoChange's events (demo's btrecvA2dpFunc) */
+#define SHANLING_PLAY_STATE	0x103	/* {duration, position, status} */
+#define SHANLING_PLAY_META	0x104	/* the phone's title, artist, album */
+#define SHANLING_A2DP_START	0x11	/* PLAY_STATE status: a phone's stream started */
+#define SHANLING_A2DP_SUSPEND	0x12	/* ... suspended */
+
+/* profiles/audio/avrcp.c: the target session demo's notifications go to */
+struct avrcp;
+extern struct avrcp *g_hci_session;
+
+/* src/shanling.c */
+void shanling_play_state(int duration, int position, int status);
