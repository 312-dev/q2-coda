+	 */
+	switch (g_high_priority_lcodec) {
+	case 0x13:
+		order[0] = 0x12d;
+		break;
+	case 0x12:
+		order[0] = 0xd7;
+		break;
+	case 0x11:
+		order[0] = 0x4f;
+		break;
+	case A2DP_CODEC_MPEG24:
