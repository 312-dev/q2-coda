@@ -0,0 +1,155 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Receiver mode's signals to demo (Q2 Pod's docs/bluetoothd.md, "Receiver mode"): stock's wrappers
+ * round bluez_play_info_signal.
+ */
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <pthread.h>
+
+#include "src/shanling.h"
+
+void shanling_play_state(int duration, int position, int status)
+{
+	int v[3] = { duration, position, status };
+
+	bluez_play_info_signal(SHANLING_PLAY_STATE, v, sizeof(v));
+}
+
+/*
+ * Browsing from the Q2's library (docs/bluetoothd.md, "Browsing"): each browsing PDU, and PlayItem, goes to
+ * coda-rc --avrcp over its UNIX socket as {u16 length, pdu, tag u32, room u16, parameters} and comes back as
+ * {u16 length, pdu, the reply's parameters}. The call blocks bluetoothd for the library's answer, at most
+ * BROWSE_TIMEOUT_S. coda-rc is started at the first request it does not answer, then at most every
+ * BROWSE_RESPAWN_S; that request, and any in between, get no answer from it.
+ */
+#include <errno.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+
+#include <glib.h>
+
+#define BROWSE_SOCKET "/tmp/coda-rc.avrcp"
+#define BROWSE_TIMEOUT_S 2
+#define BROWSE_RESPAWN_S 10
+
+static int browse_fd = -1;
+static time_t browse_spawned;
+
+static void browse_close(void)
+{
+	if (browse_fd >= 0)
+		close(browse_fd);
+	browse_fd = -1;
+}
+
+static void browse_spawn(void)
+{
+	char *argv[] = { "/usr/bin/coda-rc", "--avrcp", NULL };
+	time_t now = time(NULL);
+
+	if (browse_spawned && now - browse_spawned < BROWSE_RESPAWN_S)
+		return;
+	browse_spawned = now;
+	/* no G_SPAWN_DO_NOT_REAP_CHILD: GLib forks twice, so nothing waits on it */
+	g_spawn_async(NULL, argv, NULL, G_SPAWN_STDOUT_TO_DEV_NULL | G_SPAWN_STDERR_TO_DEV_NULL, NULL, NULL,
+								NULL, NULL);
+}
+
+static int browse_connect(void)
+{
+	struct sockaddr_un a = { .sun_family = AF_UNIX };
+	struct timeval tv = { BROWSE_TIMEOUT_S, 0 };
+
+	if (browse_fd >= 0)
+		return 0;
+	strncpy(a.sun_path, BROWSE_SOCKET, sizeof(a.sun_path) - 1);
+	browse_fd = socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+	if (browse_fd < 0)
+		return -1;
+	setsockopt(browse_fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+	setsockopt(browse_fd, SOL_SOCKET, SO_SNDTIMEO, &tv, sizeof(tv));
+	if (connect(browse_fd, (struct sockaddr *) &a, sizeof(a)) < 0) {
+		browse_close();
+		browse_spawn();
+		return -1;
+	}
+	return 0;
+}
+
+static int browse_io(uint8_t *buf, size_t n, int out)
+{
+	while (n) {
+		ssize_t r = out ? send(browse_fd, buf, n, MSG_NOSIGNAL) : read(browse_fd, buf, n);
+
+		if (r < 0 && errno == EINTR)
+			continue;
+		if (r <= 0)
+			return -1;
+		buf += r;
+		n -= r;
+	}
+	return 0;
+}
+
+static int browse_send(const uint8_t *frame, size_t n)
+{
+	/* once again on a fresh connection: coda-rc may have restarted since the last */
+	for (int tries = 0; tries < 2; tries++) {
+		if (browse_connect() < 0)
+			return -1;
+		if (!browse_io((uint8_t *) frame, n, 1))
+			return 0;
+		browse_close();
+	}
+	return -1;
+}
+
+ssize_t shanling_browse(uint32_t tag, uint8_t pdu, const uint8_t *params, uint16_t len, uint16_t room,
+						uint8_t *out, size_t cap)
+{
+	static uint8_t frame[2 + 7 + 1024];
+	uint8_t head[3];
+	size_t n;
+
+	if (len > sizeof(frame) - 9)
+		return -1;
+	n = 7 + len;
+	frame[0] = n >> 8;
+	frame[1] = n;
+	frame[2] = pdu;
+	frame[3] = tag >> 24;
+	frame[4] = tag >> 16;
+	frame[5] = tag >> 8;
+	frame[6] = tag;
+	frame[7] = room >> 8;
+	frame[8] = room;
+	memcpy(frame + 9, params, len);
+	if (browse_send(frame, 2 + n) < 0)
+		return -1;
+	if (browse_io(head, 3, 0) < 0)
+		goto failed;
+	n = (size_t) head[0] << 8 | head[1];
+	if (n < 1 || n - 1 > cap || head[2] != pdu)
+		goto failed;
+	if (browse_io(out, n - 1, 0) < 0)
+		goto failed;
+	return n - 1;
+
+failed:
+	browse_close();
+	return -1;
+}
+
+void shanling_browse_forget(uint32_t tag)
+{
+	uint8_t frame[2 + 5] = { 0, 5, 0xff, tag >> 24, tag >> 16, tag >> 8, tag };
+
+	if (browse_fd >= 0 && browse_io(frame, sizeof(frame), 1) < 0)
+		browse_close();
+}
