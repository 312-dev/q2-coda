+/*
+ * Shanling: GetElementAttributes answered from libbtctl's g_track_meta, the track demo keeps current through
+ * NotifyChanged, as stock's browsing handlers answer (docs/bluetoothd.md). Upstream's reads a registered
+ * player, and the Q2 registers none. The attributes asked for, valid ones once each in order, or all seven;
+ * one with no value is left out, unless asked for with no track (its empty value); with no track and none
+ * asked for, a title of one space. One packet: a text that would pass SHANLING_META_ROOM is cut short at a
+ * character's start.
+ */
+#define SHANLING_META_ROOM 502
+
+static unsigned int shanling_put_attr(uint8_t *out, unsigned int room, uint32_t id, const char *text,
+								unsigned int len)
+{
+	if (room < 8)
+		return 0;
+	if (len > room - 8) {
+		len = room - 8;
+		while (len && ((uint8_t) text[len] & 0xc0) == 0x80)
+			len--;
+	}
+	put_be32(id, out);
+	put_be16(AVRCP_CHARSET_UTF8, out + 4);
+	put_be16(len, out + 6);
+	memcpy(out + 8, text, len);
+	return 8 + len;
+}
+
+static const char *shanling_attr_text(const struct shanling_track_meta *m, uint32_t id, char *num,
+							unsigned int *len)
+{
+	const char *s = NULL;
+	int v;
+
+	switch (id) {
+	case AVRCP_MEDIA_ATTRIBUTE_TITLE: s = m->title; break;
+	case AVRCP_MEDIA_ATTRIBUTE_ARTIST: s = m->artist; break;
+	case AVRCP_MEDIA_ATTRIBUTE_ALBUM: s = m->album; break;
+	case AVRCP_MEDIA_ATTRIBUTE_GENRE: s = m->genre; break;
+	case AVRCP_MEDIA_ATTRIBUTE_TRACK: v = m->track; goto number;
+	case AVRCP_MEDIA_ATTRIBUTE_N_TRACKS: v = m->total; goto number;
+	case AVRCP_MEDIA_ATTRIBUTE_DURATION: v = m->time; goto number;
+	default: return NULL;
+	}
+	if (!s)
+		return NULL;
+	*len = strlen(s);
+	return s;
+number:
+	if (v < 0)
+		return NULL;
+	*len = sprintf(num, "%d", v);
+	return num;
+}
+
+static uint8_t shanling_get_element_attributes(struct avrcp *session, struct avrcp_header *pdu,
+							uint8_t transaction)
+{
+	uint16_t len = be16_to_cpu(pdu->params_len);
+	uint32_t asked[AVRCP_MEDIA_ATTRIBUTE_LAST];
+	unsigned int nattr, n = 0, pos = 1, count = 0, i, k;
+	const struct shanling_track_meta *m;
+
+	if (len < 9 || len < 9 + pdu->params[8] * 4)
+		goto err;
+	nattr = pdu->params[8];
+	if (!nattr)
+		for (n = 0; n < AVRCP_MEDIA_ATTRIBUTE_LAST; n++)
+			asked[n] = n + 1;
+	for (i = 0; i < nattr && n < AVRCP_MEDIA_ATTRIBUTE_LAST; i++) {
+		uint32_t id = get_be32(&pdu->params[9 + i * 4]);
+		bool seen = false;
+
+		for (k = 0; k < n; k++)
+			seen |= asked[k] == id;
+		if (id >= 1 && id <= AVRCP_MEDIA_ATTRIBUTE_LAST && !seen)
+			asked[n++] = id;
+	}
+	if (!n)
+		goto err;
+
+	pthread_mutex_lock(&g_notify_mutex);
+	m = g_track_meta;
+	for (i = 0; i < n; i++) {
+		char num[12];
+		unsigned int tl = 0, w;
+		const char *t = m ? shanling_attr_text(m, asked[i], num, &tl) : NULL;
+
+		if (!m && !nattr && asked[i] == AVRCP_MEDIA_ATTRIBUTE_TITLE)
+			t = " ", tl = 1;
+		if (!t && !(nattr && !m))
+			continue;
+		if (!t)
+			t = "", tl = 0;
+		w = shanling_put_attr(&pdu->params[pos], SHANLING_META_ROOM - pos, asked[i], t, tl);
+		if (!w)
+			break;
+		pos += w;
+		count++;
+	}
+	pthread_mutex_unlock(&g_notify_mutex);
+
+	pdu->params[0] = count;
+	pdu->packet_type = AVRCP_PACKET_TYPE_SINGLE;
+	pdu->params_len = cpu_to_be16(pos);
+	return AVC_CTYPE_STABLE;
+
+err:
+	pdu->params_len = cpu_to_be16(1);
+	pdu->params[0] = AVRCP_STATUS_INVALID_PARAM;
+	return AVC_CTYPE_REJECTED;
+}
+
