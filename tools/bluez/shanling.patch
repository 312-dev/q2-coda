+	uint32_t order[] = { CODEC_NONE, 0x12d /* LDAC */, 0xd7 /* aptX HD */,
+				0x4f /* aptX */, A2DP_CODEC_MPEG24, A2DP_CODEC_SBC };
+	unsigned int i;
 
 	for (; list; list = list->next) {
 		struct a2dp_sep *sep = list->data;
