-		else
-			queue_push_tail(seps, sep);
+		queue_push_tail(seps, sep);
 	}
 
-	return seps;
+	if (!seps)
+		return NULL;
+
+	/* The Quality page's codec first, then LDAC, aptX HD, aptX, AAC, SBC;
+	 * any other codec's endpoints are left out
+	 */
+	switch (g_high_priority_lcodec) {
+	case 0x13:
+		order[0] = 0x12d;
+		break;
+	case 0x12:
+		order[0] = 0xd7;
+		break;
+	case 0x11:
+		order[0] = 0x4f;
+		break;
+	case A2DP_CODEC_MPEG24:
+		order[0] = A2DP_CODEC_MPEG24;
+		break;
+	default:
+		order[0] = A2DP_CODEC_SBC;
+		break;
+	}
+
+	for (i = 1; i < G_N_ELEMENTS(order); i++)
+		if (order[i] == order[0])
+			order[i] = CODEC_NONE;
+
+	ordered = queue_new();
+
+	for (i = 0; i < G_N_ELEMENTS(order); i++) {
+		struct a2dp_sep *sep;
+
+		if (order[i] == CODEC_NONE)
+			continue;
+
+		while ((sep = queue_remove_if(seps, codec_compare, &order[i])))
+			queue_push_tail(ordered, sep);
+	}
+
+	queue_destroy(seps, NULL);
+
+	return ordered;
 }
 
