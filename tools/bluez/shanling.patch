+/* Shanling's (docs/bluetoothd.md, "Receiver mode"): the phone's track as demo's receiver page shows
+ * it, sent (PlayInfoChange 0x104) when it changes
+ */
+static struct {
+	int duration;
+	GString *title;
+	GString *artist;
+	GString *album;
+} recv_meta;
+
+/* text, len bytes of a phone's attribute, cut at a C0 80 pair (modified UTF-8's NUL) */
+static bool recv_meta_set(GString *s, const uint8_t *text, uint16_t len)
+{
+	const uint8_t *end = text + len;
+	const uint8_t *p;
+
+	for (p = text; p + 1 < end; p++)
+		if (p[0] == 0xc0 && p[1] == 0x80) {
+			end = p;
+			break;
+		}
+
+	if (s->len == (gsize) (end - text) &&
+				!memcmp(s->str, text, end - text))
+		return false;
+
+	g_string_truncate(s, 0);
+	g_string_append_len(s, (const char *) text, end - text);
+
+	return true;
+}
+
+static void recv_meta_send(void)
+{
+	GString *items[] = { recv_meta.title, recv_meta.artist, recv_meta.album };
+	uint8_t *buf = g_malloc0(1024);
+	uint32_t count = 0;
+	size_t size = 8;
+	unsigned int i;
+
+	put_le32(recv_meta.duration, buf);
+
+	for (i = 0; i < G_N_ELEMENTS(items); i++) {
+		uint16_t len = items[i]->len + 1;
+
+		if (size + 4 + len > 1024)
+			break;
+
+		put_le16(i + 1, buf + size);
+		put_le16(len, buf + size + 2);
+		memcpy(buf + size + 4, items[i]->str, len);
+		size += 4 + len;
+		count++;
+	}
+
+	put_le32(count, buf + 4);
+	bluez_play_info_signal(SHANLING_PLAY_META, buf, size);
+	g_free(buf);
+}
