+++ b/profiles/shanling/shanling.c
@@ -0,0 +1,131 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Shanling's SyncLink service record (Q2 Pod's docs/bluetoothd.md, "The shanling plugin"), as stock's
+ * bluetoothd adds it: an SDP record for Shanling's phone app to find the RFCOMM channel demo's libSL.so
+ * listens on. Nothing here listens.
+ */
+#ifdef HAVE_CONFIG_H
+#include <config.h>
+#endif
+
+#include <stdint.h>
+#include <glib.h>
+
+#include "lib/bluetooth.h"
+#include "lib/sdp.h"
+#include "lib/sdp_lib.h"
+#include "lib/uuid.h"
+
+#include "src/plugin.h"
+#include "src/adapter.h"
+#include "src/device.h"
+#include "src/profile.h"
+#include "src/service.h"
+#include "src/log.h"
+
+#define SHANLING_UUID16		0xcc0c
+#define SHANLING_UUID		"0000cc0c-0000-1000-8000-00805f9b34fb"
+#define SHANLING_CHANNEL	28
+
+static uint32_t record_handle;
+
+static sdp_record_t *shanling_record(void)
+{
+	sdp_list_t *svclass, *pfseq, *apseq, *root, *proto[2], *aproto;
+	uuid_t root_uuid, svc_uuid, l2cap, rfcomm;
+	sdp_profile_desc_t profile;
+	uint8_t channel = SHANLING_CHANNEL;
+	sdp_data_t *ch;
+	sdp_record_t *record;
+
+	record = sdp_record_alloc();
+	if (!record)
+		return NULL;
+
+	sdp_uuid16_create(&root_uuid, PUBLIC_BROWSE_GROUP);
+	root = sdp_list_append(NULL, &root_uuid);
+	sdp_set_browse_groups(record, root);
+
+	sdp_uuid16_create(&svc_uuid, SHANLING_UUID16);
+	svclass = sdp_list_append(NULL, &svc_uuid);
+	sdp_set_service_classes(record, svclass);
+
+	sdp_uuid16_create(&profile.uuid, SHANLING_UUID16);
+	profile.version = 0x0101;
+	pfseq = sdp_list_append(NULL, &profile);
+	sdp_set_profile_descs(record, pfseq);
+
+	sdp_uuid16_create(&l2cap, L2CAP_UUID);
+	proto[0] = sdp_list_append(NULL, &l2cap);
+	apseq = sdp_list_append(NULL, proto[0]);
+
+	sdp_uuid16_create(&rfcomm, RFCOMM_UUID);
+	proto[1] = sdp_list_append(NULL, &rfcomm);
+	ch = sdp_data_alloc(SDP_UINT8, &channel);
+	proto[1] = sdp_list_append(proto[1], ch);
+	apseq = sdp_list_append(apseq, proto[1]);
+
+	aproto = sdp_list_append(NULL, apseq);
+	sdp_set_access_protos(record, aproto);
+
+	sdp_set_info_attr(record, "SHANLING TG", NULL, NULL);
+
+	sdp_data_free(ch);
+	sdp_list_free(proto[0], NULL);
+	sdp_list_free(proto[1], NULL);
+	sdp_list_free(apseq, NULL);
+	sdp_list_free(aproto, NULL);
+	sdp_list_free(pfseq, NULL);
+	sdp_list_free(svclass, NULL);
+	sdp_list_free(root, NULL);
+
+	return record;
+}
+
+static int shanling_probe(struct btd_profile *p, struct btd_adapter *adapter)
+{
+	sdp_record_t *record = shanling_record();
+
+	if (!record) {
+		error("Creating shanling SDP record failed.");
+		return -1;
+	}
+
+	if (adapter_service_add(adapter, record) < 0) {
+		error("Adding shanling SDP record to the SDP server failed.");
+		sdp_record_free(record);
+		return -1;
+	}
+
+	record_handle = record->handle;
+	DBG("shanling listen RFCOMM socket Channel %d", SHANLING_CHANNEL);
+
+	return 0;
+}
+
+static void shanling_remove(struct btd_profile *p, struct btd_adapter *adapter)
+{
+	if (record_handle)
+		adapter_service_remove(adapter, record_handle);
+	record_handle = 0;
+}
+
+static struct btd_profile shanling_profile = {
+	.name		= "shanling-target",
+	.remote_uuid	= SHANLING_UUID,
+	.adapter_probe	= shanling_probe,
+	.adapter_remove	= shanling_remove,
+};
+
+static int shanling_init(void)
+{
+	return btd_profile_register(&shanling_profile);
+}
+
+static void shanling_exit(void)
+{
+	btd_profile_unregister(&shanling_profile);
+}
+
+BLUETOOTH_PLUGIN_DEFINE(shanling, VERSION, BLUETOOTH_PLUGIN_PRIORITY_DEFAULT,
+						shanling_init, shanling_exit)
