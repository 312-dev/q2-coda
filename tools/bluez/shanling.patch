+/* Shanling's codec order (docs/bluetoothd.md, "Codec priority"): an endpoint of codec c, a standard
+ * codec by its id, a vendor codec by the vendor id its local endpoint carries
+ */
+static bool codec_compare(const void *data, const void *match_data)
+{
+	const struct a2dp_sep *sep = data;
+	uint32_t codec = *(const uint32_t *) match_data;
+	uint8_t *caps;
+
+	if (sep->codec != A2DP_CODEC_VENDOR)
+		return sep->codec == codec;
+
+	if (avdtp_sep_get_user_data(sep->lsep) != sep)
+		return false;
+
+	sep->endpoint->get_capabilities((struct a2dp_sep *) sep, &caps,
+							sep->user_data);
+
+	return get_le32(caps) == codec;
+}
+
+#define CODEC_NONE	0xffffff
