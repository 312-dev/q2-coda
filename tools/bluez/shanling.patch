+static uint8_t shanling_play_item(struct avrcp *session, struct avrcp_header *pdu, uint8_t transaction)
+{
+	uint16_t len = be16_to_cpu(pdu->params_len);
+	uint8_t status;
+	ssize_t n = shanling_browse(GPOINTER_TO_UINT(session), AVRCP_PLAY_ITEM, pdu->params, len, 1, &status, 1);
+
+	pdu->packet_type = AVRCP_PACKET_TYPE_SINGLE;
+	pdu->params_len = cpu_to_be16(1);
+	pdu->params[0] = n == 1 ? status : AVRCP_STATUS_INTERNAL_ERROR;
+	return pdu->params[0] == AVRCP_STATUS_SUCCESS ? AVC_CTYPE_ACCEPTED : AVC_CTYPE_REJECTED;
+}
