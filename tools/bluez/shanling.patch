+/* text, len bytes of a phone's attribute, cut at a C0 80 pair (modified UTF-8's NUL) */
+static bool recv_meta_set(GString *s, const uint8_t *text, uint16_t len)
+{
+	const uint8_t *end = text + len;
+	const uint8_t *p;
+
+	for (p = text; p + 1 < end; p++)
+		if (p[0] == 0xc0 && p[1] == 0x80) {
+			end = p;
+			break;
+		}
