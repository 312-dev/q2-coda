#!/usr/bin/env bash
# Run a command in the Linux build environment on an Apple Silicon Mac (docs/building.md#building-on-macos):
#
#     tools/mac/q2env python3 tools/ci/rebuild.py --dev
#     tools/mac/q2env              # a shell
#
# The container is linux/amd64 (tools/mac/Dockerfile), the Mac's home is mounted at its own path and is
# HOME, and the command runs as the Mac's user in the current directory, so a repository path or a
# ~/.cache/... path means the same file inside and out. The image is built on first use and again when
# the Dockerfile, tools/mac/pidof or the pinned requirements change (its tag is their hash).
#
# ~/.cache/q2-thirdparty is also mounted at /home/gray/.cache/q2-thirdparty, GRAYTHINKPAD's path, and
# Q2_THIRDPARTY_CACHE points there: tools/thirdparty.py's cache keys and the compiler paths in its
# output include the cache's path, so only at that path does the Mac reuse the laptop's built
# components and build the same bytes.
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$here/../.." && pwd)
if [ "${1:-}" = --amd64 ]; then
    shift
    platform=linux/amd64 files=("$here/Dockerfile.amd64" "$here/pidof") name=q2env-amd64
    player_cache=$HOME/.cache/q2-player
else
    platform=linux/arm64 files=("$here/Dockerfile" "$here/cc") name=q2env
    # tools/player.py keys its host builds (test/player's FFmpeg and mbedTLS) by recipe, not by
    # architecture, so the two images keep separate caches: the arm64 linker skips x86-64 archives.
    player_cache=$HOME/.cache/q2-player-arm64
fi
tag=$(cat "${files[@]}" "$root/requirements.txt" "$root/test/unit/requirements.txt" | shasum -a 256 | cut -c1-12)
image="$name:$tag"

if ! docker image inspect "$image" >/dev/null 2>&1; then
    ctx=$(mktemp -d)
    trap 'python3 -c "import shutil,sys; shutil.rmtree(sys.argv[1])" "$ctx"' EXIT
    cp "${files[@]}" "$ctx/"
    cp "$root/requirements.txt" "$ctx/requirements.txt"
    cp "$root/test/unit/requirements.txt" "$ctx/unit-requirements.txt"
    docker build --platform "$platform" -f "$ctx/$(basename "${files[0]}")" --build-arg UID="$(id -u)" \
        --build-arg GID="$(id -g)" --build-arg USER_HOME="$HOME" -t "$image" "$ctx" >&2
fi

# The Codescape toolchain lives in a Docker volume, not under ~/.cache: the Mac's home is a
# case-insensitive APFS volume, and the toolchain's sysroots hold 136 pairs of paths that differ only
# in case (netfilter headers such as xt_MARK.h and xt_mark.h). It is unpacked as tools/thirdparty.py's
# toolchain() does (tar, then the archive's SHA-256 in .sha256), which then finds it unpacked.
tc=/home/gray/.cache/q2-thirdparty/toolchain
tc_sha=$(cd "$root/tools" && python3 -c 'import thirdparty; print(thirdparty.TOOLCHAIN[1])')
# /tmp is a tmpfs: on the container's own /tmp (overlayfs on ext4) a 32-bit program's readdir stops at
# once with EOVERFLOW, because the -m32 test programs (test/coverflow.py's) run under the VM's qemu-i386,
# not Rosetta, and the kernel gives a 64-bit process ext4's 64-bit directory offsets; tmpfs's fit in 32 bits.
# --ulimit core=0: no core dumps, as q2-heavy's runs on GRAYTHINKPAD (a crashed test would leave
# hundreds of MB in the worktree it ran in).
run=(docker run --rm --platform "$platform" --user "$(id -u):$(id -g)" --ulimit core=0 --tmpfs /tmp:exec,mode=1777,size=2g
     --security-opt seccomp=unconfined --security-opt apparmor=unconfined --security-opt systempaths=unconfined
     -v "$HOME:$HOME" -v "$HOME/.cache/q2-thirdparty:/home/gray/.cache/q2-thirdparty"
     -v q2-toolchain:$tc -v q2-os:/home/gray/.cache/q2-os
     -e HOME="$HOME" -e USER="$(id -un)" -e Q2_THIRDPARTY_CACHE=/home/gray/.cache/q2-thirdparty -e Q2_PLAYER_CACHE="$player_cache")
mkdir -p "$HOME/.cache/q2-thirdparty/toolchain"  # the volume's mount point
# Vamp OS's Buildroot tree and build directory (tools/vampos.py, docs/vamp-os-base.md) live in a volume too, at
# GRAYTHINKPAD's path: Buildroot builds the kernel headers, whose netfilter pairs differ only in case, and the
# toolchain's paths end up in its output, so the build directory has one fixed, case-sensitive place.
if ! docker run --rm --platform "$platform" -v q2-os:/v "$image" sh -c "[ \"\$(stat -c %u /v)\" = $(id -u) ]"; then
    docker run --rm --platform "$platform" --user 0 -v q2-os:/v "$image" chown "$(id -u):$(id -g)" /v
fi
if ! docker run --rm --platform "$platform" -v q2-toolchain:/v "$image" sh -c "[ -n '$tc_sha' ] && [ \"\$(cat /v/.sha256 2>/dev/null)\" = '$tc_sha' ]"; then
    archive=$HOME/.cache/q2-thirdparty/dl/mti-linux-2020.06-01.tar.gz
    if [ -f "$archive" ]; then
        echo "q2env: unpacking the toolchain into the q2-toolchain volume (once)" >&2
        docker run --rm --platform "$platform" -v q2-toolchain:/v "$image" chown "$(id -u):$(id -g)" /v
        "${run[@]}" "$image" sh -c "find $tc -mindepth 1 -delete && tar -C $tc -xzf '$archive' && printf %s '$tc_sha' > $tc/.sha256"
    fi  # else tools/thirdparty.py fetches the archive into dl/, and the next q2env unpacks it
fi

tty=()
[ -t 0 ] && [ -t 1 ] && tty=(-t)
[ $# -eq 0 ] && set -- bash
# seccomp and AppArmor unconfined: bwrap (test/adb.py, test/thirdparty.py) and unshare -Urmn
# (test/subsonic_seam.py) make user namespaces, which Docker's default profiles refuse. systempaths
# unconfined: Docker masks parts of /proc, and the kernel refuses a new proc mount (the seam test's
# unshare --pid --fork --mount-proc) over a proc with paths mounted on it.
exec "${run[@]}" -i "${tty[@]}" -e TERM="${TERM:-dumb}" -w "$PWD" "$image" "$@"
