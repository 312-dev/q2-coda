#!/usr/bin/env bash
# Run a command in Vamp's build and test environment on an Apple Silicon Mac (docs/building.md#building-on-macos):
#
#     tools/mac/q2env python3 tools/ci/rebuild.py --dev
#     tools/mac/q2env              # a shell
#
# The container is native linux/arm64 (tools/mac/Dockerfile). The Mac's home is mounted at its own path and
# is HOME, and the command runs as the Mac's user in the current directory, so a repository path or a
# ~/.cache/... path is the same file inside and out. The image is built on first use and again when its
# Dockerfile, tools/mac/cc or the pinned requirements change (its tag is their hash).
set -euo pipefail

here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
root=$(cd "$here/../.." && pwd)
tag=$(cat "$here/Dockerfile" "$here/cc" "$root/requirements.txt" "$root/test/unit/requirements.txt" | shasum -a 256 | cut -c1-12)
image="q2env:$tag"

if ! docker image inspect "$image" >/dev/null 2>&1; then
    ctx=$(mktemp -d)
    trap 'python3 -c "import shutil,sys; shutil.rmtree(sys.argv[1])" "$ctx"' EXIT
    cp "$here/Dockerfile" "$here/cc" "$ctx/"
    cp "$root/requirements.txt" "$ctx/requirements.txt"
    cp "$root/test/unit/requirements.txt" "$ctx/unit-requirements.txt"
    docker build --platform linux/arm64 --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
        --build-arg USER_HOME="$HOME" -t "$image" "$ctx" >&2
fi

# ~/.cache/q2-thirdparty is also at /home/gray/.cache/q2-thirdparty, the path its components were built at:
# tools/thirdparty.py's cache keys and the compiler paths in its output include the cache's path, so only
# there are they reused and rebuilt to the same bytes.
#
# The Codescape toolchain lives in a Docker volume over that cache's toolchain/: the Mac's home is
# case-insensitive APFS, and the toolchain's sysroots hold 136 pairs of paths that differ only in case
# (netfilter headers such as xt_MARK.h and xt_mark.h). It is unpacked as tools/thirdparty.py's toolchain()
# does (tar, then the archive's SHA-256 in .sha256), which then finds it unpacked.
tc=/home/gray/.cache/q2-thirdparty/toolchain
tc_sha=$(cd "$root/tools" && python3 -c 'import thirdparty; print(thirdparty.TOOLCHAIN[1])')
# seccomp and AppArmor unconfined: bwrap and unshare -Ur make user namespaces, which Docker's default
# profiles refuse. systempaths unconfined: Docker masks parts of /proc, and the kernel refuses the seam
# test's new proc mount (unshare --mount-proc) over a proc with paths mounted on it.
# /tmp is a tmpfs: the -m32 test programs run under qemu-i386, and on overlayfs (ext4) a 32-bit readdir
# there stops at once with EOVERFLOW, as the kernel gives a 64-bit process 64-bit directory offsets.
# No core dumps: a crashed test would leave hundreds of MB in the worktree it ran in.
# --init: PID 1 is Docker's init, which reaps orphans. Without it the command is PID 1, and a test's process
# whose parent has gone is reparented to it and stays a zombie, which kill(pid, 0) still finds alive.
# /dev/fuse: the card boot's squashfuse_ll mounts a real image over FUSE in test/q2vampos.py, inside unshare -Urm (a
# user namespace may mount FUSE; the container needs no capability for it, only the device).
run=(docker run --rm --init --platform linux/arm64 --user "$(id -u):$(id -g)" --ulimit core=0 --device /dev/fuse
     --tmpfs /tmp:exec,mode=1777,size=2g
     --security-opt seccomp=unconfined --security-opt apparmor=unconfined --security-opt systempaths=unconfined
     -v "$HOME:$HOME" -v "$HOME/.cache/q2-thirdparty:/home/gray/.cache/q2-thirdparty" -v q2-toolchain:$tc
     -v q2-os:/home/gray/.cache/q2-os
     -e HOME="$HOME" -e USER="$(id -un)" -e Q2_THIRDPARTY_CACHE=/home/gray/.cache/q2-thirdparty)
mkdir -p "$HOME/.cache/q2-thirdparty/toolchain"  # the volume's mount point
# VampOS's Buildroot tree and build directory (tools/vampos.py, docs/vamp-os-base.md) live in a volume too, at
# GRAYTHINKPAD's path: Buildroot builds the kernel headers, whose netfilter pairs differ only in case, and the
# toolchain's paths end up in its output, so the build directory has one fixed, case-sensitive place.
if ! docker run --rm --platform linux/arm64 -v q2-os:/v "$image" sh -c "[ \"\$(stat -c %u /v)\" = $(id -u) ]"; then
    docker run --rm --platform linux/arm64 --user 0 -v q2-os:/v "$image" chown "$(id -u):$(id -g)" /v
fi
if ! docker run --rm --platform linux/arm64 -v q2-toolchain:/v "$image" \
        sh -c "[ \"\$(cat /v/.sha256 2>/dev/null)\" = '$tc_sha' ]"; then
    archive=$HOME/.cache/q2-thirdparty/dl/mti-linux-2020.06-01.tar.gz
    if [ -f "$archive" ]; then
        echo "q2env: unpacking the toolchain into the q2-toolchain volume (once)" >&2
        docker run --rm --platform linux/arm64 -v q2-toolchain:/v "$image" chown "$(id -u):$(id -g)" /v
        "${run[@]}" "$image" sh -c "find $tc -mindepth 1 -delete && tar -C $tc -xzf '$archive' && printf %s '$tc_sha' > $tc/.sha256"
    fi  # else tools/thirdparty.py fetches the archive into dl/, and the next q2env unpacks it
fi

# The Mac's environment does not cross into the container except as named here: every variable named Q2* or VAMP_*
# set in the caller's does (the suites' broken copies, Q2SYSD_SOURCE and the rest, and their settings, Q2_STOCK_ZIP,
# VAMP_TARGET), so `Q2SYSD_SOURCE=COPY tools/mac/q2env python3 test/sysd.py` tests COPY and not the tree.
# Q2_THIRDPARTY_CACHE stays the container's own path, set above.
pass=()
while IFS= read -r name; do
    case $name in
        Q2_THIRDPARTY_CACHE) ;;
        Q2*|VAMP_*) pass+=(-e "$name") ;;
    esac
done < <(compgen -e)

tty=()
[ -t 0 ] && [ -t 1 ] && tty=(-t)
[ $# -eq 0 ] && set -- bash
# The working directory as the disk spells it. The Mac's home is case-insensitive, so a shell can stand in
# ~/repos/... when the folder is ~/Repos/...; inside the container that spelling still opens every file, but
# clang refuses an include whose path differs in case from the name on disk (-Wnonportable-include-path, an
# error under test/unit's -Werror host builds).
here_real=$(python3 -c 'import fcntl, os; print(fcntl.fcntl(os.open(".", os.O_RDONLY), fcntl.F_GETPATH, bytes(1024)).rstrip(b"\0").decode())' 2>/dev/null || true)
[ -d "$here_real" ] || here_real=$PWD
exec "${run[@]}" ${pass[@]+"${pass[@]}"} -i "${tty[@]}" -e TERM="${TERM:-dumb}" -w "$here_real" "$image" "$@"
