# syntax=docker/dockerfile:1.7
# The Linux build and test environment on an Apple Silicon Mac under Rosetta (docs/building.md#building-on-macos):
# tools/mac/q2env --amd64. The native image (tools/mac/Dockerfile) is the default; this one is for what is x86-only.
# linux/amd64 under Rosetta, not arm64: the Codescape MIPS toolchain (tools/thirdparty.py) and the
# pinned helpers it builds are x86-64 Linux programs. Ubuntu 24.04, as GRAYTHINKPAD runs, so clang, lld,
# squashfs-tools, ImageMagick, qemu-user and bwrap are the versions the laptop's builds use.
FROM --platform=linux/amd64 ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf automake bc build-essential bubblewrap bzip2 ca-certificates ccache clang cmake \
        dbus file gcc-multilib git golang-go imagemagick jq lame ffmpeg libavcodec-dev libavformat-dev \
        libavutil-dev libcapstone-dev libcurl4-openssl-dev libdbus-1-dev libglib2.0-dev libicu-dev \
        libmad0-dev libssl-dev libtool libusb-1.0-0-dev lld llvm ninja-build nodejs npm patchelf \
        pkg-config qemu-user squashfs-tools unzip wget xz-utils zip \
    && rm -rf /var/lib/apt/lists/*

# test/fw needs a PIE python (CLAUDE.md, Traps): Ubuntu's /usr/bin/python3 is not. This is the build
# actions/setup-python installs (the laptop's .venv runs the same one), at the prefix its rpath names.
ADD --checksum=sha256:dec61ed20cd3e71143f1642ef9966945dea8ae4f3e96b306205a710da4f2191a \
    https://github.com/actions/python-versions/releases/download/3.12.16-40260402378/python-3.12.16-linux-24.04-x64.tar.gz \
    /tmp/py.tgz
ARG PY_DIR=/opt/hostedtoolcache/Python/3.12.16/x64
RUN mkdir -p "$PY_DIR" && tar -C "$PY_DIR" -xzf /tmp/py.tgz && rm /tmp/py.tgz \
    && cd "$PY_DIR/bin" && ln -sf python3.12 python3 && ln -sf python3 python

COPY requirements.txt unit-requirements.txt /tmp/
RUN "$PY_DIR/bin/python3" -m venv /opt/q2venv \
    && /opt/q2venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt -r /tmp/unit-requirements.txt \
        pytest-xdist==3.8.0 mypy==2.4.1 \
    && rm /tmp/requirements.txt /tmp/unit-requirements.txt
ENV PATH=/opt/q2venv/bin:$PATH

# Under Rosetta /proc/PID/exe is Rosetta for every process, so procps' pidof finds nothing; this one
# matches argv[0] (tools/mac/pidof).
COPY pidof /usr/local/bin/pidof

# The Mac user's uid and home, so files written through the /Users mount keep their owner and every
# ~/... path is the same inside and out (tools/mac/q2env passes --user and HOME).
ARG UID=501
ARG GID=20
ARG USER_HOME=/Users/grayson
RUN (getent group "$GID" || groupadd -g "$GID" mac) \
    && useradd -M -d "$USER_HOME" -u "$UID" -g "$GID" -s /bin/bash mac
