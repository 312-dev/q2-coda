#!/bin/sh
# pidof by argv[0]'s name, for tools/mac/Dockerfile's image. procps' pidof also matches by
# /proc/PID/exe, and under Rosetta every process's exe is Rosetta itself, so the real one finds
# nothing there (patch/q2car.sh's release then never signals the player: test/iap_probe.py).
# Prints the matching pids on one line, exit 1 when none, as pidof does; -s, -x and -o are not taken.
found=
for name in "$@"; do
    for d in /proc/[0-9]*; do
        pid=${d#/proc/}
        [ "$pid" = $$ ] && continue
        a0=$(tr '\0' '\n' < "$d/cmdline" 2>/dev/null | head -n 1)
        [ -n "$a0" ] && [ "${a0##*/}" = "$name" ] && found="$found $pid"
    done
done
[ -n "$found" ] || exit 1
echo $found
