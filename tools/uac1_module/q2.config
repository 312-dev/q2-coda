# Applied over 5.10.21's malta_defconfig (tools/uac1_module/build.py, docs/iphone-mode.md#the-uac1-module). Each
# option either makes the vermagic the Q2's ("5.10.21+ SMP preempt mod_unload MIPS32_R5 32BIT") or matches a layout
# the stock kernel was read to have: the reason is beside it.
# CPU_BIG_ENDIAN is not set
CONFIG_CPU_LITTLE_ENDIAN=y
CONFIG_CPU_MIPS32_R5=y
CONFIG_SMP=y
CONFIG_PREEMPT=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# MODVERSIONS is not set: the Q2's modules have no __versions
# MODULE_SIG is not set: none of them is signed
# The "+" of 5.10.21+: setlocalversion adds nothing in a tarball's tree
CONFIG_LOCALVERSION="+"
# CONFIG_LOCALVERSION_AUTO is not set
# The kernel has do_raw_spin_lock and do_raw_write_lock: spinlock_t carries magic, owner and owner_cpu
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_SPINLOCK=y
# No lock_acquire, debug_mutex_init, ___might_sleep, debug_smp_processor_id
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_ATOMIC_SLEEP is not set
# CONFIG_DEBUG_PREEMPT is not set
# No report_bug or __bug_table: no bug table in struct module
CONFIG_EXPERT=y
# CONFIG_BUG is not set
# No _mcount, ftrace_caller or tracepoints
# CONFIG_FTRACE is not set
# CONFIG_TRACING is not set
# kallsyms_lookup_name, __stack_chk_guard, __dynamic_pr_debug
CONFIG_KALLSYMS=y
# No jump_label_module_notify (srcu_module_notify is there): no jump entries in struct module, and the
# exit offset (0x16c in the vendor's modules) agrees only without them
# CONFIG_JUMP_LABEL is not set
CONFIG_STACKPROTECTOR=y
CONFIG_DYNAMIC_DEBUG=y
# snd_power_wait, snd_pcm_suspend_all; /sys/power/state takes mem (stock's standby): PM_SLEEP's fields in struct device
CONFIG_PM=y
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
# pinctrl_bind_pins and dma_alloc_from_contiguous: struct device's pins and cma_area, 8 bytes that move
# struct snd_pcm's private_data to 0x51c (stock g_audio_setup, 0x804bef44: sw $16, 0x51c($4))
CONFIG_PINCTRL=y
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_SOUND=y
CONFIG_SND=y
# SND_PCM has no prompt: selected by the UAC1 function, built as a module (never used: the build is out of tree)
CONFIG_USB_CONFIGFS_F_UAC1=y
CONFIG_SND_PCM=y
CONFIG_SND_PCM_TIMER=y
CONFIG_SND_PROC_FS=y
# snd_pcm_substream_proc_hw_params_read is there, snd_pcm_xrun_debug_read and the OSS layer are not
CONFIG_SND_VERBOSE_PROCFS=y
# CONFIG_SND_DEBUG is not set
# CONFIG_SND_OSSEMUL is not set
