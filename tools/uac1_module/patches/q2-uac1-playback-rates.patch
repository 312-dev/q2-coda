+/* q2: the host chose srate for the playback endpoint (f_uac1.c's SET_CUR). The PCM opens at it from now on;
+ * with the endpoint running, the next packet is sized for it, as u_audio_start_playback sizes the first. It runs
+ * from ep0's completion, which dwc2 gives back from the same interrupt handler as every playback completion,
+ * so the two never run at once. */
+void q2_u_audio_set_playback_srate(struct g_audio *audio_dev, int srate)
+{
+	struct snd_uac_chip *uac = audio_dev->uac;
+	unsigned int maxpacket = audio_dev->in_ep->maxpacket;
+
+	audio_dev->params.p_srate = srate;
+	if (!uac->p_prm.ep_enabled)
+		return;
+	uac->p_pktsize = min_t(unsigned int, uac->p_framesize * (srate / uac->p_interval), maxpacket);
+	if (uac->p_pktsize < maxpacket)
+		uac->p_pktsize_residue = uac->p_framesize * (srate % uac->p_interval);
+	else
+		uac->p_pktsize_residue = 0;
+	uac->p_residue = 0;
+}
