+/* q2: a request for the sampling frequency control of the playback endpoint (the endpoint in wIndex's low byte) */
+static bool q2_playback_rate_control(u16 w_value, u16 w_index)
+{
+	return (w_value >> 8) == UAC_EP_CS_ATTR_SAMPLE_RATE &&
+		(w_index & 0xff) == as_in_ep_desc.bEndpointAddress;
+}
+
+/* q2: the data stage of the host's SET_CUR: a 3-byte rate, taken when the format lists it */
+static void q2_set_rate_complete(struct usb_ep *ep, struct usb_request *req)
+{
+	struct f_uac1 *uac1 = req->context;
+	u8 *buf = req->buf;
+	unsigned int rate, i;
+
+	if (req->status || req->actual != 3)
+		return;
+	rate = buf[0] | buf[1] << 8 | buf[2] << 16;
+	rate_asked = rate;
+	for (i = 0; i < as_in_type_i_desc.bSamFreqType; i++) {
+		u8 *f = as_in_type_i_desc.tSamFreq[i];
+
+		if ((f[0] | f[1] << 8 | f[2] << 16) == rate) {
+			p_rate = rate;
+			q2_u_audio_set_playback_srate(&uac1->g_audio, rate);
+			return;
+		}
+	}
+}
